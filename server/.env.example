# Horus Airport Stand Allocation - Environment Variables
# ARAJET IT Compliance Standard: ARA-MAN-TIC-2008
# NEVER commit real credentials to version control.

# Server Configuration
PORT=4000
NODE_ENV=development

# Redash API Integration (Punta Cana International Airport)
REDASH_BASE_URL=https://dashboard.puntacanainternationalairport.com
REDASH_DASHBOARD_ID=4
REDASH_QUERY_ID=27
REDASH_API_KEY=your_redash_api_key_here
REDASH_EMAIL=your_email@domain.com
REDASH_PASSWORD=your_password_here
REDASH_TERMINAL_FILTER=B
REDASH_AUTO_SYNC_INTERVAL=5

# Azure App Configuration & Key Vault Integration (When deployed in Arajet Azure Cloud)
AZURE_APP_CONFIG_ENDPOINT=https://arajet-appconfig-enterapps.azconfig.io
AZURE_KEY_VAULT_URI=https://arajet-kv-enterapps.vault.azure.net/
